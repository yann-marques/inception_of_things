Vagrant.configure("2") do |config|
  config.vm.box = "cloud-image/debian-13"

    # Set up of the libvirt env
  config.vm.provider "libvirt" do |vb|
    vb.memory = "1024"
    vb.cpus = 4
    vb.driver = "qemu"
  end

  config.vm.synced_folder "data/", "/data", type: "nfs", create:true, nfs_udp: false, mount_options: ['rw,async,fsc,nolock,tcp,hard']
  config.vm.provision "shell", "path": "data/scripts/set_up.sh" 
  
  # Server set up
  config.vm.define "cmorelS" do |server|
    server.vm.hostname = "cmorelS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provision "shell",
      path: "data/scripts/server.sh"
  end

  # Worker set up
  config.vm.define "cmorelWS" do |worker|
    worker.vm.hostname = "cmorelWS"
    worker.vm.network "private_network", ip: "192.168.56.111" 
    worker.vm.provision "shell",
      path: "data/scripts/worker.sh"
  end

end

