Vagrant.configure("2") do |config|
  config.vm.box = "cloud-image/debian-13"

    # Set up of the Virtual box env
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "1024"
    vb.cpus = 2
  end

  config.vm.synced_folder "src/", "/data"
  config.vm.provision "shell", "path": "scripts/set_up.sh" 
  config.vm.provision "shell", "path": "scripts/kubernetes.sh"

  
  # Server set up
  config.vm.define "cmorelS" do |server|
    server.vm.hostname = "cmorelS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provision "shell",
      path: "scripts/server.sh"
  end

  # Worker set up
  config.vm.define "cmorelWS" do |worker|
    worker.vm.hostname = "cmorelWS"
    worker.vm.network "private_network", ip: "192.168.56.111" 
    worker.vm.provision "shell",
      path: "scripts/worker.sh"
  end

end

