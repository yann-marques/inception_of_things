Vagrant.configure("2") do |config|
  config.vm.box = "cloud-image/debian-13"

    # Set up of the Virtual box env
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "8192"
    vb.cpus = 8
  end
  # synced
  config.vm.synced_folder "confs/", "/data/confs"
  config.vm.synced_folder "scripts/", "/data/scripts"
  config.vm.synced_folder "src/", "/data/src"

  # script exec
  config.vm.provision "shell", "path": "scripts/set_up.sh" 
  
  # Server set up
  config.vm.define "cmorelS" do |server|
    server.vm.hostname = "cmorelS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provision "shell",
      path: "scripts/server.sh"
  end
end
